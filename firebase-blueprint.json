{
  "entities": {
    "Invite": {
      "title": "Authorized User Invite",
      "description": "Admin-managed allowlist entry authorizing a Google email to log into a specific Leads Nexus Institute portal.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 128,
          "description": "Lowercase Google account email address authorized by Admin."
        },
        "role": {
          "type": "string",
          "enum": ["teacher", "student", "parent"],
          "description": "Assigned portal role for this user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full display name of the invited user."
        },
        "linkedRecordId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID in teachers, students, or parents collection."
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Whether login access is currently active or suspended."
        },
        "addedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "Admin email who created this authorization."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "displayName", "linkedRecordId", "status", "addedBy", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Diploma Course",
      "description": "Computer diploma course track at Leads Nexus Institute.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "durationMonths": {
          "type": "number"
        },
        "feeMonthly": {
          "type": "number"
        },
        "schedule": {
          "type": "string",
          "maxLength": 120
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128
        },
        "teacherName": {
          "type": "string",
          "maxLength": 120
        },
        "teacherEmail": {
          "type": "string",
          "maxLength": 128
        },
        "modules": {
          "type": "array"
        },
        "imageKey": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "code", "title", "description", "durationMonths", "feeMonthly", "schedule", "teacherId", "teacherName", "teacherEmail", "modules", "imageKey", "status", "createdAt", "updatedAt"]
    },
    "Teacher": {
      "title": "Institute Teacher",
