    "ActivityLog": {
      "title": "Activity Log Entry",
      "description": "Audit log of portal logins and administrative or staff actions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["login", "course", "teacher", "student", "parent", "attendance", "grade", "fee", "announcement", "access"]
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "details": {
          "type": "string",
          "maxLength": 500
