    "Announcement": {
      "title": "Institute Announcement",
      "description": "Notice board announcement posted by Admin or Teachers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
