      "required": ["id", "category", "action", "details", "actorName", "actorEmail", "actorRole", "targetLabel", "createdAt"]
    }
  },
  "firestore": {
    "/invites/{inviteEmail}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Pre-authorized Google email allowlist managed exclusively by Admin."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "The 5 computer diploma courses and any admin-managed tracks."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Teacher profiles and course assignments."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student records, roll numbers, and parent/course links."
    },
    "/parents/{parentId}": {
      "schema": { "$ref": "#/entities/Parent" },
      "description": "Parent and guardian records linked to students."
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Course enrollment links for role-scoped portal views."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily attendance records marked by Admin or assigned Teachers."
    },
    "/grades/{gradeId}": {
      "schema": { "$ref": "#/entities/GradeRecord" },
      "description": "Assessment scores and remarks."
    },
    "/fees/{feeId}": {
      "schema": { "$ref": "#/entities/FeeRecord" },
      "description": "Tuition fee records managed by Admin."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Institute and course announcements."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable audit log of logins and staff actions visible to Admin."
    }
  }
}
